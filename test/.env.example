# MQTT Broker Configuration
MQTT_BROKER=your-broker.example.com
MQTT_PORT=8883
MQTT_USERNAME=your-username
MQTT_PASSWORD=your-password
MQTT_USE_TLS=true
MQTT_CA_CERT=broker.crt
MQTT_TOPIC_SEND=your/topic/send
MQTT_TOPIC_RECEIVE=your/topic/receive
MQTT_TIMEOUT=5

# HTTP API Configuration
HTTP_BASE_URL=http://192.168.1.189:9090
HTTP_TIMEOUT=5
